{
  "name": "@zzhaobh/dsh-server-error-continue",
  "version": "2.4.0",
  "description": "Bounded, cancellable recovery for transient model-request failures in DeepSeek Harness: same-request retries, provider-exhaustion escalation, and bounded same-session turn restarts, guarded by a permanent-failure denylist.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "zzhaobh",
  "homepage": "https://github.com/zzhaobh/dsh-server-error-continue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzhaobh/dsh-server-error-continue.git"
  },
  "bugs": {
    "url": "https://github.com/zzhaobh/dsh-server-error-continue/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "retry",
    "error-recovery"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=20"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node --check index.js && node --test test/plugin.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
